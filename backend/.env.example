# NexlyticX reads these from the process environment (it does NOT auto-load a .env file).
# Set them in your hosting dashboard, in `docker run -e ...`, or in your shell before starting.
# Every value below is optional; the defaults shown are used when a variable is not set.

# NX_REQUIRE_LOGIN=false          # true = visitors must sign in; no guest access
# NX_DB_PATH=./data/nexlyticx.db  # SQLite file for accounts. Put it on a persistent disk in production
# NX_SESSION_TTL_MINUTES=120      # guest datasets are deleted after this much inactivity
# NX_MAX_UPLOAD_MB=20
# NX_MAX_ROWS=200000
# NX_MAX_SAVED_DATASETS=10        # per signed-in user
# NX_AUTH_TTL_DAYS=14             # how long a login lasts
# NX_RATE_LIMIT_PER_MINUTE=240    # per IP
# NX_UPLOAD_LIMIT_PER_10MIN=30    # per IP
# NX_ALLOWED_ORIGINS=             # comma separated; only needed if the frontend is hosted elsewhere
# NX_ENABLE_DOCS=false            # true = serve read-only API docs at /docs
